@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
</head>

<body>
    <h2>Login</h2>
    <p>Usuário</p>
    <input id="usu">
    <p>Senha</p>
    <input id="senha" type="password">
    <br><br>
    <button onclick="login()">Entrar</button>
    <p id="resposta"></p>
    <script>
            async function login() {
                let usu = document.getElementById("usu").value;
                let senha = document.getElementById("senha").value;
                let rota = await fetch(`/Home/logar?usu=${encodeURIComponent(usu)}&;senha=${encodeURIComponent(senha)}`);
                let resposta = await rota.text();
                if (resposta != "erro") {
                    document.getElementById("resposta").innerText = resposta;
                    alert(resposta);
                    window.location.href = "/Home/crud";
                }
                else {
                    alert("erro");
                }
            }
    </script>
</body>